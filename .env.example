# Upstream deployments (URI / credential / api_version) are configured per-row
# in the `models` table via the /admin/models UI, and the secrets they use are
# configured in /admin/credentials. There are no global upstream env vars.

# Proxy settings
PORT=8888
ENABLE_STREAMING=true
ENABLE_LOGGING=true

# The database: a Postgres DSN (required), and the schema the proxy's tables
# live in. PROXY_ALLOW_SCHEMA_CREATE=true once, for a fresh install only.
DATABASE_URL=postgresql://user:password@127.0.0.1:5432/hive
DB_SCHEMA=proxy

# Admin console. The admin is a single operator identity, not a database row;
# leaving these unset makes the console unreachable.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
SESSION_SECRET=change-me-in-production

# How often a running proxy reloads issued keys (seconds)
KEY_CACHE_REFRESH_SECONDS=5

# Usage log retention
USAGE_PRUNE_DAYS=90

# HTTPS settings (leave off when a reverse proxy terminates TLS)
USE_HTTPS=false
SSL_CERTFILE=cert.pem
SSL_KEYFILE=key.pem
